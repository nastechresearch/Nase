{
  "name": "nase-companion",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "shared",
    "relay",
    "client",
    "packages/mcp",
    "web"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "relay": "npm run start -w @nase/relay --",
