    "listen": "npm run listen -w @nase/client --",
    "mcp": "npm run start -w nase-mcp --",
    "typecheck": "tsc -p tsconfig.json",
    "describe": "node tools/describe/src/generate.mjs",
    "describe:secrets": "node tools/describe/src/secrets.mjs"
  },
  "devDependencies": {
    "yaml": "^2.9.1"
  }
