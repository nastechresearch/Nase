# Optional overrides for the MCP server and nase-phone CLI.
# Copy to .env and export the values (the processes read the environment;
# they do not load this file automatically).

# Relay HTTP origin. Default: https://relay.nase.karlmagendavid.com
# NASE_RELAY=https://relay.nase.karlmagendavid.com
# NASE_RELAY=https://relay.nase.karlmagendavid.com  # backward compat

# Name shown on the phone. Default: Grok Bot
# NASE_CLIENT_NAME=My assistant

# Where the saved pairing (and its private session key) is kept.
# Defaults: ~/.nase/mcp.json for the MCP server, ~/.nase/listen.json for the CLI.
# NASE_STATE=
# NASE_HOME=

# Set to 1 to keep a standing listener after pairing (MCP server).
# NASE_LISTEN=
