# Optional overrides for a self-hosted relay.
# Copy to .env and export the values, or pass them through docker compose.

# Listen address. Defaults: 0.0.0.0:8787
# HOST=0.0.0.0
# PORT=8787

# Public wss:// origin the phone should dial when it differs from the Host header.
# NASE_RELAY_URL=wss://relay.nase.karlmagendavid.com

# Abuse limits. Defaults are safe for the 0.6.4 phone and MCP connector.
# NASE_MAX_PAYLOAD_BYTES=16777216
# NASE_MAX_HTTP_BODY_BYTES=65536
# NASE_MAX_ROOMS=10000
# NASE_MAX_ROOMS_PER_IP=50
# NASE_MAX_PAIR_PER_IP=30
# NASE_MAX_WS_PER_IP=40
# NASE_MAX_CONNECT_PER_IP=60
# NASE_MAX_MESSAGES_PER_SEC=60
# NASE_LIMIT_WINDOW_MS=60000
